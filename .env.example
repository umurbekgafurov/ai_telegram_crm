# Telegram Bot API token, from @BotFather
BOT_TOKEN=123456789:AAExampleTokenDoNotUseInProduction

# Async SQLAlchemy DSN (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://crm:crm@postgres:5432/ai_telegram_crm

# Comma-separated list of Telegram user IDs that get admin role on /start
ADMIN_IDS=111111111,222222222

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Postgres credentials used by docker-compose (must match DATABASE_URL above)
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=ai_telegram_crm
